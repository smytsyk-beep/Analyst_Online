# Values prefixed with NEXT_PUBLIC_ are embedded into the Docker image at build time.
# Configure them as GitHub repository variables, not only in this runtime file.
NEXT_PUBLIC_SITE_URL=https://analyst-online.com
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sanity runtime access and webhook validation
SANITY_API_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
SANITY_WEBHOOK_SECRET=

# Contact form delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep escaped newlines (\n) when storing a PEM key on one line.
GOOGLE_PRIVATE_KEY=

# Contact form security
CONTACT_FORM_SECRET=
TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=true

# Optional persistent rate limiting. Without these, limits reset on app restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

